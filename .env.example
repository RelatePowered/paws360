# Supabase — get these from your project dashboard at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AWS S3 — private bucket for animal photos
# Credentials are provided automatically by the Amplify IAM role (no keys needed).
# S3_REGION falls back to AWS_REGION which Amplify sets automatically.
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
